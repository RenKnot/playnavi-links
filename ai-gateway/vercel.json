{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/",
      "destination": "https://playnavi.app/help/claude",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "https://irbtguncoatqfikctreq.supabase.co/functions/v1/mcp"
    },
    {
      "source": "/mcp/:path*",
      "destination": "https://irbtguncoatqfikctreq.supabase.co/functions/v1/mcp/:path*"
    },
    {
      "source": "/ai-auth",
      "destination": "https://irbtguncoatqfikctreq.supabase.co/functions/v1/ai-oauth"
    },
    {
      "source": "/ai-auth/:path*",
      "destination": "https://irbtguncoatqfikctreq.supabase.co/functions/v1/ai-oauth/:path*"
    }
  ],
  "headers": [
    {
      "source": "/mcp(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/ai-auth(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/.well-known/(oauth-authorization-server|oauth-protected-resource/mcp)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=60"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
